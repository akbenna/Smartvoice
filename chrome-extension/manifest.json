{
  "manifest_version": 3,
  "name": "SmartVoice — AI Consultassistent",
  "version": "1.1.0",
  "description": "Neem consulten op en genereer automatisch SOEP-notities voor Bricks Huisarts",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.bfrcloud.com/*",
    "https://*.bfrnet.nl/*",
    "https://*.bricks-huisarts.nl/*",
    "https://*.bfrw.nl/*",
    "https://*.bfrw.cloud/*",
    "https://*.brickshuisarts.nl/*",
    "https://*.bfrw-online.nl/*",
    "http://localhost:8002/*",
    "https://*.up.railway.app/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SmartVoice — AI Consultassistent"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.bfrcloud.com/*",
        "https://*.bfrnet.nl/*",
        "https://*.bricks-huisarts.nl/*",
        "https://*.bfrw.nl/*",
        "https://*.bfrw.cloud/*",
        "https://*.brickshuisarts.nl/*",
        "https://*.bfrw-online.nl/*",
        "http://localhost:8002/*"
      ],
      "js": ["content/bricks.js"],
      "css": ["content/bricks.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
