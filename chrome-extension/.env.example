# ============================================
# SmartVoice Cloud API - Environment Variables
# ============================================

# --- Server ---
HOST=0.0.0.0
PORT=8080
DEBUG=false
CORS_ORIGINS=*

# --- Authentication ---
# Comma-separated API keys for clients (Chrome extensions)
API_KEYS=sv_live_your-key-here
ADMIN_KEY=sv_admin_your-admin-key

# --- STT Providers (kies 1 of meer) ---
STT_PROVIDER=groq  # groq | deepgram | openai

# Groq (GRATIS tier, snelst)
GROQ_API_KEY=gsk_your-groq-key
GROQ_MODEL=whisper-large-v3

# Deepgram (beste Nederlands, €0.04/10min)
# DEEPGRAM_API_KEY=your-deepgram-key
# DEEPGRAM_MODEL=nova-2
# DEEPGRAM_LANGUAGE=nl

# OpenAI (€0.06/10min)
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_STT_MODEL=whisper-1

# --- LLM Providers (kies 1 of meer) ---
LLM_PROVIDER=mistral  # mistral | anthropic | gemini

# Mistral (EU-gevestigd, AVG-vriendelijk, €0.003/consult)
MISTRAL_API_KEY=your-mistral-key
MISTRAL_MODEL=mistral-small-latest

# Anthropic Claude (beste kwaliteit, €0.005/consult)
# ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Gemini (goedkoopst, €0.001/consult)
# GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-2.0-flash

# --- LLM Settings ---
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# --- Audio ---
MAX_AUDIO_SIZE_MB=50
MAX_AUDIO_DURATION=3600
TEMP_DIR=/tmp/smartvoice
